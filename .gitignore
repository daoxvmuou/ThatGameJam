# ===== Unity 标准忽略项 =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data 不忽略（.meta 必须提交）
!/[Aa]ssets/**/*.meta

# 自动生成的工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vscode/
.idea/

# Unity3D 生成的文件
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Builds / 打包
*.app
/[Ee]xported[Oo]bj/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 临时/备份
*.tmp
*.bak
*.orig
*.rej
*.log
